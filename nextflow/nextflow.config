// ============================================================
// KinSim PREPARE pipeline — generic per-sample preparation.
//
// One workflow (PREPARE) handles any HiFi / subread dataset. The shape of the
// pipeline is controlled by params; per-dataset defaults live in conf/<name>.config.
//
//   Reads (.bam | .bam.gz)            → [gunzip if .gz]
//                                     → [bystrandify if platform == 'ccs']
//                                     → pbmm2 align (preset from platform)
//                                     → samtools index + pbindex
//                                     → ipdSummary (module | container backend)
//                                     → per-sample aligned.bam + .gff + .csv
//                                     → manifest_gff.csv (gathered)
//
// Extract + merge are NOT in this pipeline — they stay in the bash/SLURM world
// (slurm_kinsim/00_extract.slurm + run_*.sh) because their concurrency + shard
// conventions are tightly coupled to the KinSim CLI.
//
// Usage:
//   nextflow run nextflow/main.nf -profile vega,slurm   -params-file nextflow/params/vega.yaml
//   nextflow run nextflow/main.nf -profile strepto,slurm -params-file nextflow/params/strepto.yaml
//   nextflow run nextflow/main.nf -profile sequel,slurm  -params-file nextflow/params/sequel.yaml
//
// Adding a new HiFi dataset:
//   1. Copy nextflow/params/vega.yaml → nextflow/params/<name>.yaml
//   2. Write a samplesheet (sample_id,reads[,reference])
//   3. Run:  nextflow run nextflow/main.nf -profile slurm -params-file nextflow/params/<name>.yaml
// ============================================================

manifest {
    name            = 'kinsim-prepare'
    description     = 'Generic PacBio HiFi / subread preparation: align + ipdSummary → manifest for KinSim extraction'
    version         = '2.0.0'
    nextflowVersion = '>=23.04.0'
}

// ------------------------- Defaults -------------------------
params {
    // Required
    samplesheet  = null                  // CSV: sample_id,reads[,reference]
    outdir       = null                  // base per-sample output dir

    // Pipeline shape
    platform     = 'ccs'                 // 'ccs' | 'subread'
    assemble     = false                 // hifiasm de novo when reference column is empty

    // Tool tuning — hifiasm
    hifiasm_extra       = ''             // arbitrary extra CLI flags, e.g. '-l0'

    // Tool tuning — pbmm2
    pbmm2_preset        = null           // null → derive from platform: ccs→CCS, subread→SUBREAD
    pbmm2_sort          = true
    pbmm2_extra         = ''

    // Tool tuning — ipdSummary
    ipd_backend         = 'module'       // 'module' (SMRT-Link 12.0 + SP3-C3) | 'container' (SMRT 25.3 default)
    ipd_identify        = 'm6A,m4C'
    ipd_methyl_fraction = true
    ipd_min_coverage    = null           // set to override tool default
    ipd_pvalue          = null
    ipd_ipd_model       = null           // override SP3-C3 (module backend only)
    ipd_extra           = ''

    // Cluster-specific tool paths
    smrt_sif       = '/containers/apptainer/pacbio-smrt-tools-25.3.sif'
    pbmm2_sif      = '/containers/apptainer/pbmm2-1.13.1.sif'
    samtools_sif   = '/containers/apptainer/samtools-1.19.sif'
    sp3_model      = '/mnt/ss/sib/ibu/rocky8/2023072800/software/SMRT-Link/12.0.0.177059-cli-tools-only/install/smrtlink-release_12.0.0.177059/bundles/smrttools/install/smrttools-release_12.0.0.177059/private/thirdparty/python3/python3_3.9.6/site-packages/kineticsTools/resources/SP3-C3.npz.gz'
    smrtlink_mod   = 'SMRT-Link/12.0.0.177059-cli-tools-only'
    conda_env      = 'kinsim_env'

    // Housekeeping
    help           = false
    manifest_name  = 'manifest_gff.csv'
    tracedir       = null                 // default: <outdir>/_nextflow
}

// ------------------------- Profiles -------------------------
profiles {
    local     { process.executor = 'local' }
    slurm     { includeConfig 'conf/slurm.config' }

    // Dataset preset profiles (activate with -profile <name>,slurm or -profile <name>,local)
    vega      { includeConfig 'conf/vega.config'    }
    strepto   { includeConfig 'conf/strepto.config' }
    sequel    { includeConfig 'conf/sequel.config'  }

    // Debug profile — verbose stdout, no resource limits
    debug {
        process.cache          = false
        process.errorStrategy  = 'terminate'
        dumpHashes             = true
    }
}

includeConfig 'conf/base.config'
