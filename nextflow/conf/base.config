// Process defaults — executor-agnostic.
// Every task activates the conda env so kinsim/samtools/pbmm2/hifiasm are on PATH.

process {
    errorStrategy = { task.exitStatus in 137..143 ? 'retry' : 'terminate' }
    maxRetries    = 1
    cache         = 'lenient'

    cpus   = 4
    memory = '16.GB'
    time   = '04:00:00'

    beforeScript = "set +u; source ~/.bashrc; conda activate ${params.conda_env ?: 'kinsim_env'}; set -euo pipefail"
}

def _trace() { params.tracedir ?: "${params.outdir}/_nextflow" }

timeline { enabled = true; overwrite = true; file = "${_trace()}/timeline.html" }
report   { enabled = true; overwrite = true; file = "${_trace()}/report.html"   }
trace    { enabled = true; overwrite = true; file = "${_trace()}/trace.tsv"; fields = 'task_id,hash,tag,process,status,exit,realtime,%cpu,rss,peak_rss,read_bytes,write_bytes' }
dag      { enabled = true; overwrite = true; file = "${_trace()}/dag.svg"       }
