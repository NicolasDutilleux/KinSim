// SLURM executor settings — enable with `-profile slurm`.

process {
    executor       = 'slurm'
    queue          = 'pibu_el8'
    clusterOptions = '--account=p774'

    withLabel: 'tiny' {
        cpus   = 1;  memory = '4.GB';  time = '00:15:00'
    }
    withLabel: 'small' {
        cpus   = 2;  memory = '8.GB';  time = '01:00:00'
    }
    withLabel: 'medium' {
        cpus   = 4;  memory = '16.GB'; time = '04:00:00'
    }
    withLabel: 'heavy' {
        cpus   = 8;  memory = '48.GB'; time = '12:00:00'
    }
    withLabel: 'assembly' {
        cpus   = 8;  memory = '64.GB'; time = '24:00:00'
    }
    withLabel: 'extract' {
        cpus   = 1;  memory = '48.GB'; time = '24:00:00'
    }

    // Global cap on concurrent submissions — polite-mode default.
    maxForks = 8
}

executor {
    name          = 'slurm'
    queueSize     = 50
    submitRateLimit = '10/1min'
}
